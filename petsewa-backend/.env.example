# ==============================================================================
# PetSewa Core Backend — Production Environment Configuration Template
# Organization: PetSewa-India
# ==============================================================================

# Application & Server Setup
PORT=3000
NODE_ENV=development # 'development' | 'staging' | 'production'
API_PREFIX=api/v1

# Relational Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password
DB_DATABASE=petsewa_db
DB_SSL_ENABLED=false

# Authentication & JWT Security Tokens
JWT_SECRET=YOUR_SUPER_SECURE_JWT_SECRET_KEY_MIN_32_CHARS
JWT_EXPIRATION=7d

# Cache, OTP & Queue Layer (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Supabase Auth Integration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Cloudflare R2 / AWS S3 Asset & Media Storage
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=petsewa-media-production
R2_PUBLIC_DOMAIN=https://media.petsewa.in

# Firebase Push Notification Service (FCM)
FIREBASE_PROJECT_ID=petsewa-production
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@petsewa-production.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"
